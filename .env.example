# RevenueCat API Keys
# Get these from https://app.revenuecat.com
EXPO_PUBLIC_RC_APPLE_KEY=
EXPO_PUBLIC_RC_GOOGLE_KEY=

# Expo Push Notifications
# Get this from your Expo project settings
EXPO_PUBLIC_PROJECT_ID=

# Supabase (Optional)
# Get these from https://supabase.com - Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (Optional - for native Google authentication)
# Get this from Google Cloud Console > APIs & Services > Credentials
# This is the Web Client ID (not Android/iOS client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=